# ─────────────────────────────────────────
# git-bridge — environment variables
# Copy to .env and fill in values
# NEVER commit .env to git
# ─────────────────────────────────────────

PORT=8080

# ─── Git Provider ─────────────────────────
# "gitlab" หรือ "github"
GIT_PROVIDER=gitlab

# ─── GitLab (ใช้เมื่อ GIT_PROVIDER=gitlab) ─
GITLAB_URL=https://gitlab.igenco.dev
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx   # Project Access Token, scope: write_repository
GITLAB_PROJECT_ID=123

# ─── GitHub (ใช้เมื่อ GIT_PROVIDER=github) ─
# github.com
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx  # Fine-grained token, scope: Contents (read/write)
GITHUB_OWNER=igenco                           # org หรือ username
GITHUB_REPO=my-repo

# GitHub Enterprise Server (GHES) — uncomment ถ้าใช้
# GITHUB_API_URL=https://github.igenco.dev/api/v3

# ─── Common ───────────────────────────────
BASE_BRANCH=main

# MantisBT webhook HMAC secret
WEBHOOK_SECRET=your-strong-random-secret-here

# Shared token สำหรับ PHP plugin button
API_TOKEN=your-strong-random-token-here

# Status ที่จะ trigger auto branch (comma-separated, lowercase)
TRIGGER_STATUSES=assigned,in progress
